# Optional overrides for the local Docker Compose stack.
FRONTEND_PORT=8080
# Reserved for the optional database profile; no database starts by default.
POSTGRES_DB=renseller
POSTGRES_USER=renseller
POSTGRES_PASSWORD=renseller_local
# Backend: Supabase project URL (verifies sign-in tokens) and Claude API key for Smart search.
SUPABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
